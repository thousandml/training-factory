#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import time
from pathlib import Path

import torch
from transformers import AutoConfig

from lib.utils.cq_quantizer import CQModelWrapper


def default_output_dir(model_name: str) -> Path:
    root = Path(os.environ.get("CQ_OUTPUT_ROOT", "quantized_models")).expanduser()
    # return root / f"cq_{model_name.replace('/', '_')}"
    return root / f"{model_name.rstrip('/').split('/')[-1]}-CQ-4bit"


class StreamingConfigShell(torch.nn.Module):
    """Config-only shell; never materializes the source model."""

    def __init__(self, config):
        super().__init__()
        self.config = config


def quantize_model(model_name: str, output_dir: Path, device: str, verbose: bool) -> None:
    print(f"[CQ] model:  {model_name}")
    print(f"[CQ] output: {output_dir}")
    print(f"[CQ] device: {device}")

    cfg = AutoConfig.from_pretrained(
        model_name,
        trust_remote_code=True,
        token=os.environ.get("HF_TOKEN", True),
    )

    architectures = getattr(cfg, "architectures", None) or []
    print(f"[CQ] architecture: {architectures[0] if architectures else 'Unknown'}")

    output_dir.mkdir(parents=True, exist_ok=True)
    model = StreamingConfigShell(cfg)
    wrapper = CQModelWrapper(model)

    started = time.time()
    stats, _ = wrapper.quantize_model_layer_by_layer(
        model_name=model_name,
        exclude_patterns=None,
        verbose=verbose,
        device=device,
        save_path=str(output_dir),
        save_incremental=True,
        native_vllm_layout=True,
    )
    elapsed = time.time() - started

    print(f"[CQ] quantization completed in {elapsed:.1f}s")
    print("[CQ] stats:")
    print(json.dumps(stats, indent=2, default=str))
    print()
    print("[CQ] next step:")
    print(
        "  python build_convert_upload.py "
        f"--model {model_name} --no-upload"
    )
    print("[CQ] omit --no-upload when you want to publish to Hugging Face.")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="quantize-model",
        description="Stream a Hugging Face model through the CQ layer-by-layer quantizer.",
    )
    parser.add_argument("model", help="Hugging Face model ID or local model directory")
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=None,
        help="Output directory (default: $CQ_OUTPUT_ROOT/<model>-CQ-4bit; CQ_OUTPUT_ROOT defaults to ./quantized_models)",
    )
    parser.add_argument("--device", default="cuda", help="Quantization device (default: cuda)")
    parser.add_argument("--quiet", action="store_true", help="Reduce per-target logging")
    args = parser.parse_args()

    output_dir = args.output_dir or default_output_dir(args.model)
    quantize_model(args.model, output_dir.resolve(), args.device, not args.quiet)


if __name__ == "__main__":
    main()
